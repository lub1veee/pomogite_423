<Page x:Class="ShutIKrol.Views.Pages.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Книга">
    <ScrollViewer>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Обложка -->
            <Image x:Name="ImgCover" Grid.Row="0" Grid.RowSpan="4" Grid.Column="0"
                   Height="280" Width="180" Stretch="UniformToFill" VerticalAlignment="Top" Margin="0,0,15,0"/>

            <!-- Название -->
            <TextBlock x:Name="TxtTitle" Grid.Row="0" Grid.Column="1" 
                       FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <!-- Автор -->
            <TextBlock x:Name="TxtAuthor" Grid.Row="1" Grid.Column="1" 
                       FontSize="14" Margin="0,0,0,8"/>

            <!-- Жанры -->
            <TextBlock x:Name="TxtGenres" Grid.Row="2" Grid.Column="1" 
                       FontSize="13" Foreground="Gray" Margin="0,0,0,8" TextWrapping="Wrap"/>

            <!-- Описание -->
            <TextBlock x:Name="TxtDescription" Grid.Row="3" Grid.Column="1" 
                       TextWrapping="Wrap" Margin="0,0,0,10"/>

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,5">
                <Button Content="Читать" Click="BtnRead_Click" Margin="0,0,8,0" Padding="8,4"/>
                <Button Content="Жалоба на книгу" Click="BtnComplainBook_Click" Margin="0,0,8,0" Padding="8,4"/>
                <Button Content="Жалоба на автора" Click="BtnComplainAuthor_Click" Margin="0,0,8,0" Padding="8,4"/>
                <Button x:Name="BtnFreezeBook" Content="Заморозить книгу" Click="BtnFreezeBook_Click" Margin="0,0,8,0" Padding="8,4" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Оставить отзыв -->
            <GroupBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Header="Оставить отзыв" Margin="0,10,0,10">
                <StackPanel Margin="5">
                    <TextBlock Text="Оценка (1-10):"/>
                    <TextBox x:Name="TxtRate" Width="60" HorizontalAlignment="Left" Margin="0,2,0,6"/>
                    <TextBlock Text="Текст отзыва:"/>
                    <TextBox x:Name="TxtReviewText" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,2,0,6"/>
                    <Button Content="Отправить отзыв" Click="BtnSubmitReview_Click" HorizontalAlignment="Left" Padding="8,4"/>
                </StackPanel>
            </GroupBox>

            <!-- Отзывы -->
            <GroupBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Header="Отзывы" Margin="0,0,0,10">
                <ItemsControl x:Name="ReviewsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5" Margin="0,3">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding UserName}" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Rate}" Foreground="Orange"/>
                                        <TextBlock Text="/10" Foreground="Gray"/>
                                        <TextBlock Text="{Binding Date}" Foreground="Gray" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Button Content="Пожаловаться на отзыв" Tag="{Binding Id}" Click="BtnComplainReview_Click" Padding="5,2" Margin="0,0,8,0"/>
                                        <Button Content="Заморозить отзыв" Tag="{Binding Id}" Click="BtnFreezeReview_Click" Padding="5,2"
                                                Visibility="{Binding FreezeVisibility}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</Page>
