<Page x:Class="ShutIKrol.Views.Pages.ReadListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Списки книг">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Списки книг" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Переключение списков -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="В планах" Tag="1" Click="BtnSwitchList_Click" Margin="0,0,5,0" Padding="8,4"/>
            <Button Content="Читаю" Tag="2" Click="BtnSwitchList_Click" Margin="0,0,5,0" Padding="8,4"/>
            <Button Content="Прочитано" Tag="3" Click="BtnSwitchList_Click" Margin="0,0,5,0" Padding="8,4"/>
            <Button Content="Заброшено" Tag="4" Click="BtnSwitchList_Click" Padding="8,4"/>
        </StackPanel>

        <!-- Фильтры -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSearch" Grid.Column="0" Margin="0,0,5,0" 
                     TextChanged="Filter_Changed" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Сортировка:" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <ComboBox Grid.Column="2" x:Name="CmbSort" SelectionChanged="Filter_Changed" Width="120">
                <ComboBoxItem Content="По названию" IsSelected="True"/>
                <ComboBoxItem Content="По оценке"/>
            </ComboBox>
            <TextBlock Grid.Column="3" Text="Жанр:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <ComboBox Grid.Column="4" x:Name="CmbGenre" SelectionChanged="Filter_Changed" Width="120"/>
        </Grid>

        <ScrollViewer Grid.Row="3">
            <ItemsControl x:Name="BooksPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="8" Width="170">
                            <StackPanel>
                                <Image Source="{Binding CoverPath}" Height="120" Stretch="UniformToFill"/>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,2"/>
                                <TextBlock Text="{Binding AuthorName}" Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="{Binding AvgRating}" FontSize="11"/>
                                <Button Content="Открыть" Tag="{Binding Id}" Click="BtnOpenBook_Click" Margin="0,4,0,2" Padding="5,2"/>
                                <Button Content="Переместить" Tag="{Binding Id}" Click="BtnMove_Click" Padding="5,2"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
