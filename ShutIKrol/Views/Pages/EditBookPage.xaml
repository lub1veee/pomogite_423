<Page x:Class="ShutIKrol.Views.Pages.EditBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактировать книгу">
    <ScrollViewer>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TxtPageTitle" Text="Добавить книгу" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Grid.Row="1" Text="Название книги:"/>
            <TextBox Grid.Row="2" x:Name="TxtName" Margin="0,3,0,10"/>

            <TextBlock Grid.Row="3" Text="Путь к обложке (файл):"/>
            <Grid Grid.Row="4" Margin="0,3,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtCoverPath" Grid.Column="0" Margin="0,0,5,0"/>
                <Button Content="Обзор" Grid.Column="1" Click="BtnBrowseCover_Click" Padding="8,4"/>
            </Grid>

            <TextBlock Grid.Row="5" Text="Жанры:"/>
            <ListBox Grid.Row="6" x:Name="GenresList" Height="100" SelectionMode="Multiple" Margin="0,3,0,10"/>

            <TextBlock Grid.Row="7" Text="Главы (путь к файлу .txt для каждой):" Margin="0,0,0,5"/>
            <StackPanel Grid.Row="8">
                <ItemsControl x:Name="ChaptersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" VerticalContentAlignment="Center"/>
                                <TextBox Grid.Column="2" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="3" Content="Удалить" Tag="{Binding Number}" Click="BtnRemoveChapter_Click" Padding="5,2"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+ Добавить главу" Click="BtnAddChapter_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,4"/>
                <Button Content="Сохранить книгу" Click="BtnSave_Click" HorizontalAlignment="Left" Margin="0,15,0,0" Padding="10,5"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
