<Page x:Class="ShutIKrol.Views.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Страница автора">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Мои книги" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить книгу" Click="BtnAddBook_Click" Margin="0,0,10,0" Padding="8,4"/>
            <CheckBox x:Name="ChkShowFrozen" Content="Показать замороженные" Checked="ChkShowFrozen_Changed" Unchecked="ChkShowFrozen_Changed" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="BooksList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding CoverPath}" Height="80" Width="60" Stretch="UniformToFill"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Content="Редактировать" Tag="{Binding Id}" Click="BtnEdit_Click" Margin="0,2" Padding="8,4"/>
                                    <Button Content="Оспорить заморозку" Tag="{Binding Id}" Click="BtnAppeal_Click"
                                            Visibility="{Binding AppealVisibility}" Margin="0,2" Padding="8,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
