<Page x:Class="ShutIKrol.Views.Pages.ReadBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Читать книгу">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="← Назад" Click="BtnBack_Click" Margin="0,0,10,0" Padding="8,4"/>
            <TextBlock x:Name="TxtBookTitle" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Глава:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="CmbChapters" Width="250" SelectionChanged="CmbChapters_SelectionChanged"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="TxtContent" TextWrapping="Wrap" FontSize="14" Padding="10"
                       LineHeight="24"/>
        </ScrollViewer>
    </Grid>
</Page>
