<Page x:Class="ShutIKrol.Views.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль">
    <ScrollViewer>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Профиль" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

            <GroupBox Grid.Row="1" Header="Информация о пользователе" Margin="0,0,0,10">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtName"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Логин:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtLogin"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtEmail"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Роль:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtRole"/>
                </Grid>
            </GroupBox>

            <!-- Заморозка -->
            <GroupBox Grid.Row="2" x:Name="FrozenGroup" Header="⚠ Аккаунт заморожен" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel Margin="5">
                    <TextBlock x:Name="TxtFreezeReason" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Content="Оспорить заморозку" Click="BtnAppealFreeze_Click" HorizontalAlignment="Left" Padding="8,4"/>
                </StackPanel>
            </GroupBox>

            <!-- Заявка на автора -->
            <GroupBox Grid.Row="3" Header="Роль автора" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <TextBlock x:Name="TxtAuthorStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button x:Name="BtnApplyAuthor" Content="Подать заявку на роль Автора" 
                            Click="BtnApplyAuthor_Click" HorizontalAlignment="Left" Padding="8,4"/>
                </StackPanel>
            </GroupBox>

            <!-- Отзывы пользователя -->
            <GroupBox Grid.Row="4" Header="Мои отзывы" Margin="0,0,0,10">
                <ItemsControl x:Name="ReviewsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5" Margin="0,3">
                                <StackPanel>
                                    <TextBlock Text="{Binding BookName}" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Оценка: "/>
                                        <TextBlock Text="{Binding Rate}" Foreground="Orange"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Date}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</Page>
