<Window x:Class="ShutIKrol.Views.Pages.AddToListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить в список" Height="200" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Выберите список:" Margin="0,0,0,8"/>
        <ComboBox Grid.Row="1" x:Name="CmbStatus" Margin="0,0,0,12">
            <ComboBoxItem Content="В планах" Tag="1" IsSelected="True"/>
            <ComboBoxItem Content="Читаю" Tag="2"/>
            <ComboBoxItem Content="Прочитано" Tag="3"/>
            <ComboBoxItem Content="Заброшено" Tag="4"/>
        </ComboBox>
        <Button Grid.Row="2" Content="Сохранить" Click="BtnSave_Click" HorizontalAlignment="Center" Padding="15,5"/>
    </Grid>
</Window>
