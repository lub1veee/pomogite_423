<Window x:Class="ShutIKrol.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши - Вход" Height="400" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Читай, Пиши и не спиши" FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TabControl Grid.Row="1" x:Name="TabAuth">
            <TabItem Header="Вход">
                <StackPanel Margin="10">
                    <TextBlock Text="Логин:"/>
                    <TextBox x:Name="TxtLogin" Margin="0,2,0,8"/>
                    <TextBlock Text="Пароль:"/>
                    <PasswordBox x:Name="TxtPassword" Margin="0,2,0,8"/>
                    <TextBlock x:Name="TxtLoginError" Foreground="Red" Visibility="Collapsed"/>
                    <Button Content="Войти" Click="BtnLogin_Click" Margin="0,10,0,0" Padding="5"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Регистрация">
                <StackPanel Margin="10">
                    <TextBlock Text="Имя:"/>
                    <TextBox x:Name="TxtRegName" Margin="0,2,0,6"/>
                    <TextBlock Text="Логин:"/>
                    <TextBox x:Name="TxtRegLogin" Margin="0,2,0,6"/>
                    <TextBlock Text="Email:"/>
                    <TextBox x:Name="TxtRegEmail" Margin="0,2,0,6"/>
                    <TextBlock Text="Пароль:"/>
                    <PasswordBox x:Name="TxtRegPassword" Margin="0,2,0,6"/>
                    <TextBlock x:Name="TxtRegError" Foreground="Red" Visibility="Collapsed"/>
                    <Button Content="Зарегистрироваться" Click="BtnRegister_Click" Margin="0,10,0,0" Padding="5"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
