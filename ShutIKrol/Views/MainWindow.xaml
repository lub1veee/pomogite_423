<Window x:Class="ShutIKrol.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="LightGray" VerticalAlignment="Stretch">
            <Button x:Name="BtnCatalog" Click="BtnCatalog_Click" Height="50" Margin="5,5,5,2" ToolTip="Каталог книг">
                <TextBlock Text="📚" FontSize="22" HorizontalAlignment="Center"/>
            </Button>
            <Button x:Name="BtnLists" Click="BtnLists_Click" Height="50" Margin="5,2,5,2" ToolTip="Списки книг">
                <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center"/>
            </Button>
            <Button x:Name="BtnAuthor" Click="BtnAuthor_Click" Height="50" Margin="5,2,5,2" ToolTip="Страница автора" Visibility="Collapsed">
                <TextBlock Text="✍️" FontSize="22" HorizontalAlignment="Center"/>
            </Button>
            <Button x:Name="BtnAdmin" Click="BtnAdmin_Click" Height="50" Margin="5,2,5,2" ToolTip="Администрирование" Visibility="Collapsed">
                <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center"/>
            </Button>
            <Button x:Name="BtnFrozen" Click="BtnFrozen_Click" Height="50" Margin="5,2,5,2" ToolTip="Аккаунт заморожен!" Visibility="Collapsed">
                <TextBlock Text="❄️" FontSize="22" HorizontalAlignment="Center"/>
            </Button>
            <Button x:Name="BtnProfile" Click="BtnProfile_Click" Height="50" Margin="5,2,5,2" ToolTip="Профиль">
                <TextBlock Text="👤" FontSize="22" HorizontalAlignment="Center"/>
            </Button>
        </StackPanel>

        <Frame Grid.Column="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
