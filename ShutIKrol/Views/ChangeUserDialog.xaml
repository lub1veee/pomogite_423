<Window x:Class="ShutIKrol.Views.ChangeUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShutIKrol.Views"
        mc:Ignorable="d"
        Title="ChangeUserDialog" Height="200" Width="330">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="UsernameBlock" HorizontalAlignment="Center"/>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Роль" FontSize="20" Width="150"/>
                <ComboBox x:Name="RolesCombobox" Width="150"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ПаРоль" FontSize="20" Width="150"/>
                <TextBox x:Name="PasswordBox" FontSize="20" Width="150"/>
            </StackPanel>
            <Button x:Name="FreezeButton" Click="FreezeButton_Click" Width="150" Height="30" FontSize="20"/>
        </StackPanel>
        <Button Grid.Row="2" Content="Изменить" Click="SaveClick" HorizontalAlignment="Center" Padding="15,5"/>
    </Grid>
</Window>
